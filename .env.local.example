NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Google OAuth Web client ID, used for Google One Tap / automatic sign-in.
# Find it in the Firebase console: Authentication > Sign-in method > Google >
# Web SDK configuration > "Web client ID". Leave unset to disable One Tap.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_web_client_id

# --- Server-only (beta tester gate). NEVER prefix these with NEXT_PUBLIC_ ---

# Supabase project URL + service-role key (Project Settings > API). The
# service-role key bypasses RLS and must stay server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Firebase Admin service account (Firebase console > Project settings >
# Service accounts > Generate new private key). Paste the private key as a
# single line with literal \n in place of newlines, wrapped in quotes.
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
